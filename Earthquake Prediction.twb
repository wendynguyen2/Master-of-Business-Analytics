    <worksheet name='Countries experiencing both tsunami and earthquake'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold'>Countries and regions experiencing both tsunami and earthquake: </run>
            <run fontcolor='#000000' fontname='Tableau Bold'>Tsunami Percentage of Total Earthquake Events </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='earthquakes' name='federated.0azel1l1s87e5e1eomlzl0f6ccvm' />
          </datasources>
          <datasource-dependencies datasource='federated.0azel1l1s87e5e1eomlzl0f6ccvm'>
            <column caption='Event Type' datatype='string' name='[Calculation_736620024294166530]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [tsunami] = 1 THEN &quot;Tsunami&quot; ELSE &quot;Non-Tsunami&quot; END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Id' datatype='string' name='[id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_736620024294166530]' derivation='None' name='[none:Calculation_736620024294166530:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[id]' derivation='CountD' name='[pcto:ctd:id:qk:7]' pivot='key' type='quantitative'>
              <table-calc ordering-type='CellInPane' type='PctTotal' />
            </column-instance>
            <column caption='Tsunami' datatype='integer' name='[tsunami]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0azel1l1s87e5e1eomlzl0f6ccvm].[none:country:nk]'>
            <groupfilter expression='SUM([tsunami]) &gt; 0' function='filter' user:ui-filter-by-field='true' user:ui-marker='filter-by'>
              <groupfilter function='except' user:ui-domain='cascading' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
                <groupfilter function='level-members' level='[none:country:nk]' />
                <groupfilter function='member' level='[none:country:nk]' member='%null%' />
              </groupfilter>
            </groupfilter>
          </filter>
          <manual-sort column='[federated.0azel1l1s87e5e1eomlzl0f6ccvm].[none:country:nk]' direction='ASC'>
